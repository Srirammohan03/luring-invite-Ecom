generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VideoJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Category {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  parentId  String?
  parent    Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]         @relation("CategoryTree")
  templates TemplateCategory[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([parentId])
}

model Template {
  id                      Int                @id @default(autoincrement())
  title                   String
  slug                    String             @unique
  description             String?            @db.Text
  thumbnail               String?
  previewVideo            String?
  sourceVideo             String?
  price                   Decimal            @default(299.00) @db.Decimal(10, 2)
  durationSeconds         Int                @default(0)
  active                  Boolean            @default(true)
  musicConfigured         Boolean            @default(false)
  musicTracks             MusicTrack[]       @relation("TemplateMusic")
  legacyPlaceholderConfig Json?
  categories              TemplateCategory[]
  frames                  TemplateFrame[]
  videoJobs               VideoJob[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  cartItem   CartItem[]
  orderItems OrderItem[]

  @@index([active, createdAt])
}

model TemplateCategory {
  templateId Int
  categoryId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([templateId, categoryId])
  @@index([categoryId])
}

model TemplateFrame {
  id                Int      @id @default(autoincrement())
  templateId        Int
  frameNumber       Int
  title             String?
  sourceVideo       String?
  previewImage      String?
  placeholderConfig Json
  durationSeconds   Int?
  template          Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([templateId, frameNumber])
  @@index([templateId, frameNumber])
}

model MusicTrack {
  id        String     @id @default(cuid())
  title     String     @unique
  path      String     @unique
  duration  Int?
  enabled   Boolean    @default(true)
  templates Template[] @relation("TemplateMusic")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([enabled, title])
}

model VideoJob {
  id               String            @id @default(cuid())
  templateId       Int
  status           VideoJobStatus    @default(PENDING)
  input            Json
  outputPath       String?
  finalPath        String?
  error            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  template         Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  purchases        VideoPurchase[]
  checkoutSessions CheckoutSession[]

  @@index([templateId, createdAt])
  @@index([status, createdAt])
}

model CmsAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     CmsSession[]
}

model CmsSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     CmsAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model CmsLoginLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum CmsContentStatus {
  DRAFT
  PUBLISHED
}

model CmsContent {
  id        String           @id @default(cuid())
  title     String
  key       String           @unique
  type      String
  content   Json
  status    CmsContentStatus @default(DRAFT)
  version   Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, key])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      CartUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum OrderStatus {
  PENDING
  PROCESSING
  CONFIRMED
  CANCELLED
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CheckoutStatus {
  STARTED
  PENDING
  COMPLETED
  ABANDONED
}

model CartUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts            Cart[]
  sessions         UserSession[]
  orders           Order[]
  checkoutSessions CheckoutSession[]
  customer         Customer?

  @@index([createdAt])
}

model Order {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique @default(cuid())
  userId               String?
  cartId               String?
  customerEmail        String
  customerName         String?
  customerPhone        String?
  customerId           String?
  guestAccessTokenHash String?
  currency             String             @default("INR")
  subtotal             Decimal            @default(0) @db.Decimal(10, 2)
  discount             Decimal            @default(0) @db.Decimal(10, 2)
  tax                  Decimal            @default(0) @db.Decimal(10, 2)
  razorpayOrderId      String?            @unique
  razorpayPaymentId    String?            @unique
  failureReason        String?            @db.Text
  paidAt               DateTime?
  status               OrderStatus        @default(PENDING)
  paymentStatus        OrderPaymentStatus @default(PENDING)
  total                Decimal            @db.Decimal(10, 2)
  items                OrderItem[]
  user                 CartUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cart                 Cart?              @relation(fields: [cartId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  payments             Payment[]
  videoPurchases       VideoPurchase[]
  webhookEvents        PaymentWebhook[]
  checkoutSession      CheckoutSession?

  @@index([userId, createdAt])
  @@index([cartId])
  @@index([customerEmail])
  @@index([customerId, createdAt])
  @@index([guestAccessTokenHash])
  @@index([paymentStatus, createdAt])
  @@index([status, createdAt])
}

model CheckoutSession {
  id             String         @id @default(cuid())
  cartId         String?
  userId         String?
  guestId        String?
  customerEmail  String?
  videoJobId     String?
  orderId        String?        @unique
  status         CheckoutStatus @default(STARTED)
  lastActivityAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cart Cart?     @relation(fields: [cartId], references: [id], onDelete: SetNull)
  user CartUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  videoJob VideoJob? @relation(fields: [videoJobId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, lastActivityAt])
  @@index([userId, createdAt])
  @@index([cartId])
  @@index([guestId])
  @@index([customerEmail])
  @@index([videoJobId])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  templateId    Int?
  templateTitle String
  quantity      Int       @default(1)
  unitPrice     Decimal   @db.Decimal(10, 2)
  videoJobId    String?
  customization Json?
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template      Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([orderId])
  @@index([templateId])
}

model Customer {
  id             String    @id @default(cuid())
  userId         String?   @unique
  fullName       String
  email          String    @unique
  primaryPhone   String
  alternatePhone String?
  address        String
  city           String
  state          String
  country        String
  postalCode     String
  companyName    String?
  user           CartUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([primaryPhone])
  @@index([createdAt])
}

model Payment {
  id                String             @id @default(cuid())
  orderId           String
  razorpayOrderId   String             @unique
  razorpayPaymentId String?            @unique
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("INR")
  status            OrderPaymentStatus @default(PENDING)
  method            String?
  signatureVerified Boolean            @default(false)
  failureReason     String?            @db.Text
  providerPayload   Json?
  paidAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model PaymentWebhook {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  orderId     String?
  payload     Json
  processedAt DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model VideoPurchase {
  id         String   @id @default(cuid())
  orderId    String
  videoJobId String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  videoJob   VideoJob @relation(fields: [videoJobId], references: [id], onDelete: Restrict)

  @@unique([orderId, videoJobId])
  @@index([videoJobId])
}

model Cart {
  id String @id @default(cuid())

  userId String?
  user   CartUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestId String? @unique

  items CartItem[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  checkoutSessions CheckoutSession[]

  @@index([userId, updatedAt])
}

model CartItem {
  id         String @id @default(cuid())
  cartId     String
  templateId Int
  quantity   Int    @default(1)

  unitPrice Decimal @db.Decimal(10, 2)

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, templateId])
  @@index([templateId])
}
